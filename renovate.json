{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "NODE_VERSION du build Pages, aligné sur mise.toml",
      "managerFilePatterns": ["/^wrangler\\.toml$/"],
      "matchStrings": ["NODE_VERSION = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    },
    {
      "customType": "regex",
      "description": "Extension gh-actions-lock épinglée dans verify-lockfile.yml (--pin vX.Y.Z)",
      "managerFilePatterns": ["/^\\.github/workflows/verify-lockfile\\.yml$/"],
      "matchStrings": ["--pin (?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "github/gh-actions-lock",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "lockFileMaintenance"],
      "automerge": true
    },
    {
      "description": "mise.toml et wrangler.toml dans la même PR (vérifié par node-version.yml)",
      "matchDepNames": ["node"],
      "groupName": "Node.js"
    },
    {
      "description": "gh-actions-lock : pas d'automerge (0.x, format du verrou encore mouvant)",
      "matchDepNames": ["github/gh-actions-lock"],
      "automerge": false
    }
  ]
}
